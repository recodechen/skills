{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "responsibility-map.schema.json",
  "title": "Responsibility Map Semantic Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "map",
    "nodes",
    "relations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "startId": {
          "type": "string",
          "minLength": 1
        },
        "endId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "symbol",
          "symbolKind",
          "summary",
          "responsibility",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "symbolKind": {
            "enum": [
              "class",
              "struct",
              "interface",
              "enum",
              "namespace",
              "function",
              "method",
              "module",
              "target",
              "other"
            ]
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "notResponsibleFor": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "enum": [
              "confirmed",
              "inferred",
              "unresolved"
            ]
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "confidence": {
                  "enum": ["confirmed", "inferred"]
                }
              },
              "required": [
                "confidence"
              ]
            },
            "then": {
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relationKind",
          "confidence"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "relationKind": {
            "enum": [
              "orchestration",
              "coordination",
              "scheduling",
              "ownership",
              "call",
              "dependency",
              "reference",
              "validation",
              "publication",
              "production",
              "consumption"
            ]
          },
          "description": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "confirmed",
              "inferred",
              "unresolved"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "confidence": {
                  "enum": ["confirmed", "inferred"]
                }
              },
              "required": [
                "confidence"
              ]
            },
            "then": {
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "The viewer checks unique node IDs, relation endpoints, anchor endpoint existence, and undirected anchor connectivity. Skill validation also checks source locations and semantic claims."
}
